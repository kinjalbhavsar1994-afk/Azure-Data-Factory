{
	"name": "df_Enrich_Orders",
	"properties": {
		"description": "Enrich Orders",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_sql_factOrders",
						"type": "DatasetReference"
					},
					"name": "RawSource"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_dimCustomer",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_dimProducts",
						"type": "DatasetReference"
					},
					"name": "Products"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sql_factOrders",
						"type": "DatasetReference"
					},
					"name": "FinalDestination"
				}
			],
			"transformations": [
				{
					"name": "OrderswithCustomers"
				},
				{
					"name": "OrdersEnrich"
				},
				{
					"name": "WithProfit"
				},
				{
					"name": "FinalEnrich"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          Shippingcost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RawSource",
				"source(output(",
				"          CustomerId as string,",
				"          FullName as string,",
				"          Email as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          CustomerSegment as string,",
				"          JoinDate as date,",
				"          LoadAt as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Customers",
				"source(output(",
				"          ProductId as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          Subcategory as string,",
				"          Brand as string,",
				"          UnitPrice as decimal(10,2),",
				"          CostPrice as decimal(10,2),",
				"          IsActive as boolean,",
				"          Supplier as string,",
				"          LoadAt as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Products",
				"RawSource, Customers join(RawSource@CustomerId == Customers@CustomerId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrderswithCustomers",
				"OrderswithCustomers, Products join(RawSource@ProductId == Products@ProductId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrdersEnrich",
				"OrdersEnrich derive(ProfitMarginPct = (NetRevenue - Quantity * CostPrice)/iif(NetRevenue == toDecimal(0), toDecimal(1),NetRevenue) * toDecimal(100),",
				"          CostOfGoods = Quantity * CostPrice,",
				"          GrossProfit = NetRevenue - (Quantity * CostPrice)) ~> WithProfit",
				"WithProfit select(mapColumn(",
				"          OrderId,",
				"          CustomerId = RawSource@CustomerId,",
				"          ProductId = RawSource@ProductId,",
				"          Customername,",
				"          Productname = RawSource@Productname,",
				"          Category = Products@Category,",
				"          OrderDate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice = RawSource@UnitPrice,",
				"          Discountpct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          Shippingcost,",
				"          NetRevenue,",
				"          CostofGoods = RawSource@CostofGoods,",
				"          GrossProfit,",
				"          PaymentMethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region,",
				"          CustomerId = Customers@CustomerId,",
				"          FullName,",
				"          Email,",
				"          City,",
				"          State,",
				"          Country,",
				"          CustomerSegment,",
				"          JoinDate,",
				"          ProductId = Products@ProductId,",
				"          ProductName = Products@ProductName,",
				"          Category = Products@Category,",
				"          Subcategory,",
				"          Brand,",
				"          UnitPrice = Products@UnitPrice,",
				"          CostPrice,",
				"          IsActive,",
				"          Supplier,",
				"          ProfitMarginPct,",
				"          CostOfGoods = WithProfit@CostOfGoods",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalEnrich",
				"FinalEnrich sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          OrderDate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          Shippingcost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          OrderId,",
				"          Category,",
				"          CustomerId,",
				"          ProductId,",
				"          Customername = FullName,",
				"          Productname = FinalEnrich@ProductName,",
				"          Category,",
				"          OrderDate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quantity,",
				"          UnitPrice,",
				"          Discountpct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          Shippingcost,",
				"          NetRevenue,",
				"          CostofGoods = FinalEnrich@CostOfGoods,",
				"          GrossProfit,",
				"          PaymentMethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region",
				"     )) ~> FinalDestination"
			]
		}
	}
}